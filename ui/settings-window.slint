import { Button, ComboBox, StyleMetrics } from "std-widgets.slint";
import { I18n } from "i18n.slint";

export component SettingsWindow inherits Window {
    title: I18n.settings-title;
    icon: @image-url("icon/settings.png");
    width: 420px;
    height: 320px;

    // UI theme: "auto" (follow system), "light" or "dark".
    in-out property <string> theme: "auto";
    callback theme-changed(string);
    // UI language code: "en" (English) or "zh" (中文).
    in-out property <string> language: "en";
    callback language-changed(string);

    property <bool> dark: StyleMetrics.window-background.to-oklch().lightness < 0.5;

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        Text {
            text: I18n.theme-label;
            font-size: 14px;
            font-weight: 700;
            color: dark ? #e2e8f0 : #0f172a;
        }
        ComboBox {
            model: I18n.theme-options;
            current-index: root.theme == "auto" ? 0 : (root.theme == "light" ? 1 : 2);
            selected() => {
                root.theme = self.current-index == 0 ? "auto" : (self.current-index == 1 ? "light" : "dark");
                root.theme-changed(root.theme);
            }
        }
        Text {
            text: I18n.theme-hint;
            font-size: 12px;
            color: dark ? #8b98ab : #64748b;
        }

        Rectangle {
            height: 1px;
            background: dark ? #3b4453 : #dde5ee;
        }

        Text {
            text: I18n.lang-label;
            font-size: 14px;
            font-weight: 700;
            color: dark ? #e2e8f0 : #0f172a;
        }
        ComboBox {
            model: I18n.lang-options;
            current-index: root.language == "zh" ? 1 : 0;
            selected() => {
                root.language = self.current-index == 0 ? "en" : "zh";
                root.language-changed(root.language);
            }
        }
        Text {
            text: I18n.lang-hint;
            font-size: 12px;
            color: dark ? #8b98ab : #64748b;
        }

        HorizontalLayout {
            alignment: end;
            Button {
                text: I18n.btn-close;
                clicked => { root.close(); }
            }
        }
    }
}